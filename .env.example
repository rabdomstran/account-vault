# Decide backend (ADR-001). Local d1-2B is the primary; point at TypeSafe
# for the hosted Jev baseline / escalation path.
# Local (default dev):  SYSTEMONE_BASE_URL=http://127.0.0.1:8000  (vLLM server)
# Hosted Jev:           SYSTEMONE_BASE_URL=https://api.typesafe.ai
SYSTEMONE_BASE_URL=http://127.0.0.1:8000
# Gateways serving the same model under another path (e.g. /v1/evaluate)
# can override this; upstream jev-ultrafast hardcodes host+path (issue #241).
SYSTEMONE_PATH=/v1/systemone
SYSTEMONE_MODEL=d1-2B
SYSTEMONE_API_KEY=

# TYPE_TEXT helper (small OpenAI-compatible model; jev-ultrafast pattern).
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_API_KEY=
# none = reasoning disabled; omit = send no reasoning field (some providers
# reject one with HTTP 400 — upstream issue #11); otherwise an effort level.
TEXT_MODEL_REASONING=none
